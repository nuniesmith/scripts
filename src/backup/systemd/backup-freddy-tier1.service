[Unit]
Description=freddy tier-1 backup (databases + config)
Documentation=https://github.com/nuniesmith/scripts/blob/main/src/backup/README.md
After=network-online.target
Wants=network-online.target
# A failure nobody sees is how freddy went two nights without a backup.
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=%h/github/scripts/src/backup/backup-freddy-tier1.sh
Nice=10
IOSchedulingClass=idle
